<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (Widgets.kt, WalletsWidget): each wallet's balance and the total. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallets_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wallets_title"
            style="@style/WidgetTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/widget_wallets_name" />

        <TextView
            android:id="@+id/wallets_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wallets_empty"
        style="@style/WidgetEmpty"
        android:text="@string/widget_open" />

    <LinearLayout android:id="@+id/wallet_row_1" style="@style/WidgetRow" android:visibility="gone">
        <TextView android:id="@+id/wallet_name_1" style="@style/WidgetRowName" />
        <TextView android:id="@+id/wallet_amount_1" style="@style/WidgetRowAmount" />
    </LinearLayout>

    <LinearLayout android:id="@+id/wallet_row_2" style="@style/WidgetRow" android:visibility="gone">
        <TextView android:id="@+id/wallet_name_2" style="@style/WidgetRowName" />
        <TextView android:id="@+id/wallet_amount_2" style="@style/WidgetRowAmount" />
    </LinearLayout>

    <LinearLayout android:id="@+id/wallet_row_3" style="@style/WidgetRow" android:visibility="gone">
        <TextView android:id="@+id/wallet_name_3" style="@style/WidgetRowName" />
        <TextView android:id="@+id/wallet_amount_3" style="@style/WidgetRowAmount" />
    </LinearLayout>

    <LinearLayout android:id="@+id/wallet_row_4" style="@style/WidgetRow" android:visibility="gone">
        <TextView android:id="@+id/wallet_name_4" style="@style/WidgetRowName" />
        <TextView android:id="@+id/wallet_amount_4" style="@style/WidgetRowAmount" />
    </LinearLayout>
</LinearLayout>
