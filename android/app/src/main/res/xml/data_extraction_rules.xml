<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data (incl. the encrypted session) out of cloud backups
     and device-to-device transfers. Everything lives in Supabase; logging in again
     on a new phone restores it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
