<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talks to Supabase (same backend as the Catalyst web app). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Reminders (check-in, bills, dhar) are scheduled on the phone and put back
         after a restart. POST_NOTIFICATIONS comes from flutter_local_notifications. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- No SMS permission: Play Protect blocks sideloaded apps that ask for one. A
         bKash / Nagad message reaches the app only when the user shares it. -->

    <application
        android:label="Catalyst"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Sign-in links back into the app: password reset emails and Google
                 sign-in (Supabase redirects to com.havic47.catalyst://login-callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.havic47.catalyst" android:host="login-callback"/>
            </intent-filter>
            <!-- A bKash / Nagad message shared from the Messages app (Share → Catalyst):
                 MainActivity hands the text to the app, which suggests the entry. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- supabase_flutter reads those links itself; keep Flutter's router out of it. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- Scheduled reminders (flutter_local_notifications), restored after a reboot or an update. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Home-screen widgets (Widgets.kt): spent today with a quick add, this month,
             wallets, bills due, and a mood check-in. -->
        <receiver android:name=".CatalystWidget" android:exported="true" android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/catalyst_widget_info"/>
        </receiver>
        <receiver android:name=".MonthWidget" android:exported="true" android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_month_info"/>
        </receiver>
        <receiver android:name=".WalletsWidget" android:exported="true" android:label="@string/widget_wallets_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wallets_info"/>
        </receiver>
        <receiver android:name=".BillsWidget" android:exported="true" android:label="@string/widget_bills_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bills_info"/>
        </receiver>
        <receiver android:name=".MoodWidget" android:exported="true" android:label="@string/widget_mood_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mood_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Memo scanner: lets the app find the phone's camera app (Android 11+).
             No CAMERA permission is needed — the camera app takes the photo. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- Update banner: opens the new APK's download link in the browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
